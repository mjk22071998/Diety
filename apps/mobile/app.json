{
  "expo": {
    "name": "Diety Mobile",
    "slug": "diety-mobile",
    "scheme": "diety",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diety.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Diety requires camera access for verified video consultations with practitioners.",
        "NSMicrophoneUsageDescription": "Diety requires microphone access for audio during live consultations.",
        "NSFaceIDUsageDescription": "Diety uses Face ID to securely authenticate and access your escrow and clinical records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.diety.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Diety to use Face ID for biometric authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
