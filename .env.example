# ==============================================================================
# BACKEND API CONFIGURATION (apps/api/.env)
# ==============================================================================
NODE_ENV=development
PORT=3301
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3300,http://localhost:3302

# PostgreSQL Database Connection
DATABASE_URL=postgresql://diety_admin:local_dev_secret_password@localhost:5432/diety_platform_db?schema=public

# Valkey Connection (Open Source Redis Protocol Engine)
VALKEY_HOST=localhost
VALKEY_PORT=6379
# Backward-compatibility aliases for Redis client libraries (ioredis / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
VALKEY_URL=redis://localhost:6379

# Cryptographic Tokens (Argon2 & JWT)
JWT_ACCESS_SECRET=local_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=local_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Local Object Storage (MinIO S3)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_local_secret
S3_BUCKET_DOCUMENTS=diety-documents
S3_BUCKET_EVIDENCE=diety-evidence

# Local AI Engine (Ollama - $0 Academic Operating Budget)
OLLAMA_BASE_URL=http://localhost:11434
# Latest conversational model for multi-turn clinical patient simulation (Meta)
OLLAMA_SIMULATION_MODEL=llama3.1:8b
# Latest clinical reasoning model for objective rubric grading (92.5% USMLE benchmark, CoT <think>)
OLLAMA_GRADING_MODEL=deepseek-r1:8b
# Lightweight fallback models for low-VRAM systems: llama3.2:3b / qwen2.5:7b

# WebRTC STUN Server
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# ==============================================================================
# WEB APPLICATION CONFIGURATION (apps/web/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3301/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3301
NEXT_PUBLIC_WEBRTC_STUN=stun:stun.l.google.com:19302

# ==============================================================================
# ADMIN CONSOLE CONFIGURATION (apps/admin/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3301/api/v1
ADMIN_SESSION_COOKIE_SECRET=local_admin_cookie_secret_at_least_32_characters

# ==============================================================================
# MOBILE APPLICATION CONFIGURATION (apps/mobile/.env)
# ==============================================================================
EXPO_PUBLIC_API_URL=http://10.0.2.2:3301/api/v1 # Android Emulator loopback
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3301
